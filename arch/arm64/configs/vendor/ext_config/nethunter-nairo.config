CONFIG_MODULES=y
CONFIG_DIAG=y
CONFIG_DIAG_CHAR=y
CONFIG_DIAG_BRIDGE_CODE=y
CONFIG_DIAG_MDM_DISABLED=n
CONFIG_DIAGFWD_BRIDGE_CODE=y

# Compression options
CONFIG_KERNEL_GZIP=y
CONFIG_KERNEL_BZIP2=n
CONFIG_KERNEL_LZMA=n
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_LZO=n
CONFIG_KERNEL_LZ4=n
CONFIG_KERNEL_ZSTD=n

# CONFIG_COMPAT_VDSO is not set
CONFIG_VIRTUALIZATION=y

CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_MNT_NS=y
CONFIG_CGROUPS=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
#
# Kernel debugging / tracing
#

CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_STACKTRACE=y
CONFIG_FRAME_POINTER=y

CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_TRACEPOINTS=y
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_IRQSOFF_TRACER is not set
# CONFIG_PREEMPT_TRACER is not set


#
# Qualcomm debug infrastructure
#


#
# Wireless core / monitor mode support
#

CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_WEXT=y

CONFIG_PACKET=y
CONFIG_NET_RAW=y

CONFIG_MAC80211_MESH=y
CONFIG_RFKILL=y


#
# Qualcomm WiFi driver debug (vendor kernels)
#

CONFIG_QCA_CLD_WLAN=m
CONFIG_QCOM_WCNSS_CORE=y
CONFIG_QCOM_WCNSS_CTRL=y

CONFIG_WLAN_FEATURE_MONITOR_MODE=y
CONFIG_WLAN_FEATURE_PACKET_FILTERING=y


#
# Wireless frame injection (USB adapter support, built as modules)
#
# NOTE: Monitor mode + packet injection on the internal WCN3990 WLAN
# depends on the out-of-tree qcacld host driver (WLAN_FEATURE_MONITOR_MODE
# above), not on kernel config. These modules add support for classic
# NetHunter USB OTG injection dongles.
#

CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_HTC_DEBUGFS=y

CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m

CONFIG_RTLWIFI=m
CONFIG_RTLWIFI_DEBUG=y
CONFIG_RTL8192CU=m

CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m

CONFIG_88XXAU=m


#
# Wireless / cfg80211 / mac80211 debugging
#

CONFIG_CFG80211_DEBUGFS=y

CONFIG_MAC80211_DEBUGFS=y
CONFIG_MAC80211_MESSAGE_TRACING=y
CONFIG_MAC80211_DEBUG_MENU=y
CONFIG_MAC80211_VERBOSE_DEBUG=y
CONFIG_MAC80211_MLME_DEBUG=y
CONFIG_MAC80211_HT_DEBUG=y
CONFIG_MAC80211_OCB_DEBUG=y
CONFIG_MAC80211_IBSS_DEBUG=y
CONFIG_MAC80211_PS_DEBUG=y
CONFIG_MAC80211_TDLS_DEBUG=y
CONFIG_MAC80211_MPL_DEBUG=y
CONFIG_MAC80211_MPATH_DEBUG=y
CONFIG_MAC80211_MHWMP_DEBUG=y


#
# Bluetooth core and debugging
#

CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y

CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

CONFIG_BT_DEBUG=y
CONFIG_BT_DEBUGFS=y

CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_HCIUART_AG6XX=y

CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y


#
# HID support
#

CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y

CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

CONFIG_HID_MULTITOUCH=y


#
# USB HID gadget (NetHunter-style USB HID)
#

CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y

CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_HID=y

# Qualcomm USB controller
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_DUAL_ROLE=y


#
# Namespace support / containers
#

CONFIG_NAMESPACES=y

CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS_NS=y
CONFIG_TIME_NS=y

# Mount namespaces
CONFIG_MNT_NS=y


#
# Cgroups for containers
#

CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y


#
# Filesystems for containers
#

CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

CONFIG_OVERLAY_FS=y

CONFIG_FUSE_FS=y
CONFIG_CUSE=y


#
# binfmt support (QEMU/user emulation)
#

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y


#
# Container security / isolation
#

CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y


#
# Kernel module support (development)
#

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set


#
# Performance/debug statistics
#

CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y

CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y

CONFIG_SCHED_INFO=y
CONFIG_SCHEDSTATS=y


#
# Useful Android debugging interfaces
#

CONFIG_PROC_EVENTS=y
CONFIG_NETLINK_DIAG=y
CONFIG_INET_DIAG=y
# Debugging
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
CONFIG_FRAME_POINTER=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_MAGIC_SYSRQ=y

# Containers
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y


#
# Modem / baseband / WLAN firmware debugging (Qualcomm)
#
# DIAG (diagchar), IPC logging, QMI, SSR, SMP2P, PIL and minidump are
# enabled above/in nairo_defconfig. These add the remaining debug hooks.
#

CONFIG_CNSS_QMI_SVC=y
CONFIG_QCOM_DYN_MINIDUMP_STACK=y

# Networking
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_VLAN_8021Q=y

# Vsockets
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y

# eBPF
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y

# Virtualization
CONFIG_KVM=y
CONFIG_KVM_ARM_HOST=y
